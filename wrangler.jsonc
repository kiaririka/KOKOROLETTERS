{
  "name": "kokoroletters",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-24",
  "keep_vars": true,
  "vars": {
    "APP_URL": "https://kokoroletters.isha201001-apc.workers.dev",
    "EMAIL_FROM": "Kokoro Letters <onboarding@resend.dev>"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
