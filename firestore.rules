rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Newsletter & Monthly Teasers:
    // Public visitors can register (create) and check their own email (get).
    // Only authenticated admin (the monthly reminder script) can list all emails.
    match /newsletter/{email} {
      allow get: if true;
      allow create: if request.resource.data.email is string;
      allow list: if request.auth != null;
      allow update, delete: if false;
    }

    // Waitlist:
    match /waitlist/{email} {
      allow get: if true;
      allow create: if request.resource.data.email is string;
      allow list: if request.auth != null;
      allow update, delete: if false;
    }

    // Orders / Subscriptions:
    match /orders/{docId} {
      allow get: if true;
      allow create: if request.resource.data.email is string;
      allow list: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
