rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Newsletter (including Monthly Teasers):
    // Anyone can check if their own email exists (get) and register (create),
    // but no one can list/download the full database or overwrite/delete records.
    match /newsletter/{email} {
      allow get: if true;
      allow create: if request.resource.data.email is string;
      allow update, delete: if false;
      allow list: if false;
    }

    // Waitlist:
    match /waitlist/{email} {
      allow get: if true;
      allow create: if request.resource.data.email is string;
      allow update, delete: if false;
      allow list: if false;
    }

    // Orders/Subscribers:
    match /orders/{docId} {
      allow get: if true;
      allow create: if request.resource.data.email is string;
      allow update, delete: if false;
      allow list: if false;
    }
  }
}
