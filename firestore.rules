rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Waitlist: visitors can append their email, but cannot read or modify others
    match /waitlist/{docId} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if false;
    }

    // Newsletter: visitors can sign up, but cannot read or modify others
    match /newsletter/{docId} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if false;
    }

    // Orders/Subscribers: visitors can submit orders, but cannot read or modify others
    match /orders/{docId} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if false;
    }
  }
}
