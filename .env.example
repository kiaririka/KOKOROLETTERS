# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- CLOUDFLARE PAGES + RESEND CONFIGURATION ---
# Required for Cloudflare Pages Functions (/functions/api/*)
AUTH_SECRET="replace_with_random_32_char_secret_string"
RESEND_API_KEY="re_your_resend_api_key_here"
# Before adding a domain, test with Resend sandbox sender (sends only to your own Resend account email):
# EMAIL_FROM="Kokoro Letters <onboarding@resend.dev>"
# After verifying your domain in Resend:
EMAIL_FROM="Kokoro Letters <letters@yourdomain.com>"

# Optional (recommended once you harden firestore.rules):
# FIREBASE_PROJECT_ID="kokoro-letters"
# FIREBASE_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# --- PRODUCTION EMAIL DELIVERY CONFIGURATION (server.ts SMTP fallback) ---
# Configure these to send real magic links via email to your users.
# You can use standard SMTP (SendGrid, Mailgun, AWS SES, Resend, etc.)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASSWORD="re_your_smtp_password_here"
EMAIL_FROM="Kokoro Letters <letters@yourdomain.com>"

# --- PRODUCTION PAYMENT GATEWAY WEBHOOK SECRETS ---
# 1. Razorpay (Indian Gateway): Secret configured in the Razorpay Dashboard under Webhooks
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# 2. PayPal (International Gateway): Webhook ID generated in the PayPal Developer Portal
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"
# If verifying via Live/Sandbox PayPal endpoint, specify environment: 'live' or 'sandbox'
PAYPAL_MODE="sandbox"
